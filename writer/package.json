{
  "name": "varnaakshara-writer",
  "version": "0.1.0",
  "description": "A free Microsoft Word alternative for Indian languages — part of the Varnaakshara IME suite",
  "main": "src/main.js",
  "author": "Varnaakshara",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"webpack serve --config webpack.config.js --mode development\" \"wait-on http://localhost:9000 && electron .\"",
    "build": "webpack --config webpack.config.js --mode production",
    "start": "electron .",
    "package": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "lexical": "^0.20.0",
    "@lexical/react": "^0.20.0",
    "@lexical/rich-text": "^0.20.0",
    "@lexical/list": "^0.20.0",
    "@lexical/table": "^0.20.0",
    "@lexical/link": "^0.20.0",
    "@lexical/code": "^0.20.0",
    "@lexical/selection": "^0.20.0",
    "@lexical/utils": "^0.20.0",
    "@lexical/html": "^0.20.0",
    "@lexical/markdown": "^0.20.0",
    "@lexical/history": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "docx": "^9.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "mammoth": "^1.10.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "webpack": "^5.96.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "babel-loader": "^9.2.1",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.0",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.varnaakshara.writer",
    "productName": "Varnaakshara Writer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/bridge.py",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../core/engine",
        "to": "engine",
        "filter": ["**/*.py", "**/*.json"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    }
  }
}
